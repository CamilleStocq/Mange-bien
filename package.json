{
  "name": "mange-bien",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mange bien ! — application personnelle de nutrition, batch cooking, sport et progression (PWA).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json && tsc -p tsconfig.sw.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs",
    "vapid": "node scripts/gen-vapid.mjs",
    "worker:dev": "npm run build && wrangler dev --test-scheduled --persist-to ../.mange-bien-state",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.2.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.4.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "http_ece": "^1.2.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.30.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
